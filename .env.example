# Optional: RUNE Connect source builds
# `cp .env.example .env` enables RUNE Connect against the production deployment.
# These are the same public identifiers baked into official release builds, not
# secrets. Remove or comment them out to build with cloud features disabled.
# Do not add server-side secrets to this file.

# Production Clerk instance. To use your own, get these from the Clerk Dashboard
# under API keys, JWT templates, and OAuth applications.
RUNE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudDMuY29kZXMk
RUNE_CLERK_JWT_TEMPLATE=rune-relay
RUNE_CLERK_CLI_OAUTH_CLIENT_ID=hzxSgY2cH10sDU2r

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in RUNE_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# RUNE_APPLE_TEAM_ID=ABC1234567
# RUNE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/rune.provisionprofile
# RUNE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Production relay. For a self-hosted relay, `infra/relay` deploys update it
# automatically.
RUNE_RELAY_URL=https://relay.rune.dev

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://app.rune.dev; override to test against a staging deployment.
# RUNE_HOSTED_APP_URL=https://nightly.app.rune.dev

# Public, ingest-only mobile OpenTelemetry configuration.
# RUNE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# RUNE_MOBILE_OTLP_TRACES_DATASET=rune-mobile-traces-dev
# RUNE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
